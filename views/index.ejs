<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <a href="/"><title>PixelLog - Retro Tech Feed</title></a>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" type="image/x-icon" href="/icons/pixellog_favicon.png" />
</head>
<body>

  <header class="site-header">
    <a href="/"></a><h1>&gt; PixelLog_</h1></a>
    <p>a retro feed for gadgets, anime, games &amp; tech stories worth remembering</p>
  </header>

  <main class="feed-container">

    <!-- ===================== CREATE POST CARD ===================== -->
    <section class="create-card pixel-border">
      <h2>+ New Memory</h2>
      <form action="/create" method="POST">
        <div class="form-row">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" placeholder="e.g. My First Walkman" required />
        </div>

        <div class="two-col">
          <div class="form-row">
            <label for="category">Category</label>
            <select id="category" name="category">
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }); %>
            </select>
          </div>

          <div class="form-row">
            <label for="imageUrl">Image URL</label>
            <input type="url" id="imageUrl" name="imageUrl" placeholder="https://..." />
          </div>
        </div>

        <div class="form-row">
          <label for="content">Story Content</label>
          <textarea id="content" name="content" placeholder="Tell the story..." required></textarea>
        </div>

        <button type="submit" class="btn btn-yellow btn-block">Post Memory</button>
      </form>
    </section>

    <!-- ===================== FEED ===================== -->
    <% if (posts.length === 0) { %>
      <div class="empty-state">
        NO POSTS YET<br />
        BE THE FIRST TO SHARE A MEMORY
      </div>
    <% } else { %>
      <% posts.forEach(function(post) { %>
        <article
          class="post-card pixel-border-sm"
          data-id="<%= post.id %>"
          data-title="<%= post.title %>"
          data-category="<%= post.category %>"
          data-image="<%= post.imageUrl %>"
          data-content="<%= post.content %>"
          data-created="<%= post.createdAt %>"
        >
          <div class="post-card-img-wrap">
            <img
              src="<%= post.imageUrl %>"
              alt="<%= post.title %>"
              loading="lazy"
              onerror="this.onerror=null; this.replaceWith(pixelFallback('<%= post.category %>'));"
            />
          </div>
          <div class="post-card-body">
            <div class="post-card-top">
              <span class="badge cat-<%= post.category %>"><%= post.category %></span>
              <span class="post-card-date"><%= new Date(post.createdAt).toLocaleDateString() %></span>
            </div>
            <h3 class="post-card-title"><%= post.title %></h3>
            <p class="post-card-excerpt"><%= post.content %></p>
          </div>
        </article>
      <% }); %>
    <% } %>

  </main>

  <!-- ===================== RETRO CONTROLLER NAV PILL ===================== -->
  <nav class="dpad-nav pixel-border" id="dpadNav">

    <!-- Popup menu (opens above the pill) -->
    <div class="dpad-popup pixel-border-sm" id="dpadPopup">
      <div class="dpad-popup-panel" id="panelMain">
        <div class="dpad-popup-title">&gt; PixelLog_</div>

        <a class="dpad-popup-item" href="https://github.com/jpldeleon/pixellog" target="_blank" rel="noopener noreferrer">
          <span class="dpad-popup-icon icon-yellow">⌥</span>
          <span>PixelLog Repo</span>
        </a>

        <button class="dpad-popup-item" id="emailCopyBtn" type="button" data-mail-b64="anBsZW9uYXJkLmRlbGVvbkBnbWFpbC5jb20=">
          <span class="dpad-popup-icon icon-green">✉</span>
          <span>Email Me</span>
        </button>

        <a class="dpad-popup-item" href="https://jpldeleon.github.io/" target="_blank" rel="noopener noreferrer">
          <span class="dpad-popup-icon icon-blue">▤</span>
          <span>CV</span>
        </a>

        <button class="dpad-popup-item" id="projectDirBtn" type="button">
          <span class="dpad-popup-icon icon-purple">▦</span>
          <span>Project Directory</span>
          <span class="dpad-popup-arrow">›</span>
        </button>
      </div>

      <!-- Project Directory panel hidden by default -->
      <div class="dpad-popup-panel" id="panelProjects" hidden>
        <button class="dpad-popup-back" id="projectsBackBtn" type="button">‹ BACK</button>
        <div class="dpad-popup-title">&gt; Directory_</div>

        <a class="dpad-popup-item" href="https://johnoffthewall.github.io/" target="_blank" rel="noopener noreferrer">
          <span class="dpad-popup-icon icon-red">◆</span>
          <span>John Off the Wall</span>
        </a>

        <a class="dpad-popup-item" href="https://jamporudex.onrender.com/" target="_blank" rel="noopener noreferrer">
          <span class="dpad-popup-icon icon-yellow">◆</span>
          <span>JamporuDEX</span>
        </a>

        <a class="dpad-popup-item" href="https://auditkit.onrender.com/" target="_blank" rel="noopener noreferrer">
          <span class="dpad-popup-icon icon-blue">◆</span>
          <span>AuditKit</span>
        </a>

        <a class="dpad-popup-item" href="https://route196.onrender.com/" target="_blank" rel="noopener noreferrer">
          <span class="dpad-popup-icon icon-green">◆</span>
          <span>Route 196</span>
        </a>
      </div>
    </div>

    <!-- Controller buttons with retro face button classes -->
    <button class="dpad-btn ctrl-btn-menu" id="navPixelLog" title="PixelLog Menu" aria-haspopup="true" aria-expanded="false">
      <span class="dpad-icon">☰</span>
      <span class="dpad-label">MENU</span>
    </button>
    <button class="dpad-btn ctrl-btn-new" id="navNewMemory" title="New Memory">
      <span class="dpad-icon">✚</span>
      <span class="dpad-label">NEW</span>
    </button>
    <button class="dpad-btn ctrl-btn-mode" id="navThemeToggle" title="Toggle light/dark mode">
      <span class="dpad-icon">◐</span>
      <span class="dpad-label">MODE</span>
    </button>
    <button class="dpad-btn ctrl-btn-top" id="navScrollTop" title="Back to top">
      <span class="dpad-icon">▲</span>
      <span class="dpad-label">TOP</span>
    </button>
  </nav>

  <!-- ===================== TOAST ===================== -->
  <div class="toast pixel-border-sm" id="toast"></div>

  <!-- ===================== 8-BIT LIGHTBOX MODAL ===================== -->
  <div class="lightbox-overlay" id="lightboxOverlay">
    <div class="lightbox pixel-border" id="lightboxBox">
      <div class="lightbox-img-side" id="lightboxImgSide">
  <img id="lightboxImg" src="" alt="" />
  <div class="post-card-img-fallback" id="lightboxFallback" style="display:none;">
    <div>▨▨▨<br/>▨▨▨</div><div>IMAGE NOT FOUND</div>
  </div>
</div>
      <div class="lightbox-info-side">
        <button class="lightbox-close" id="lightboxClose">✕ CLOSE</button>
        <span class="badge" id="lightboxBadge"></span>
        <h2 id="lightboxTitle"></h2>
        <div class="lightbox-timestamp" id="lightboxTimestamp"></div>
        <p class="lightbox-story" id="lightboxStory"></p>
        <div class="lightbox-actions">
          <a id="lightboxEditLink" href="#" class="btn btn-blue btn-sm">✎ EDIT</a>
          <form id="lightboxDeleteForm" action="/delete/" method="POST" onsubmit="return confirm('Delete this memory forever?');">
            <button type="submit" class="btn btn-red btn-sm">🗑 DELETE</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    const themeToggle = document.getElementById('navThemeToggle');
    const savedTheme = localStorage.getItem('pixellog-theme');
    if (savedTheme === 'light') {
      document.body.classList.add('light-theme');
    }
    themeToggle.addEventListener('click', function () {
      document.body.classList.toggle('light-theme');
      localStorage.setItem(
        'pixellog-theme',
        document.body.classList.contains('light-theme') ? 'light' : 'dark'
      );
    });

    document.getElementById('navScrollTop').addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    document.getElementById('navNewMemory').addEventListener('click', function () {
      closeDpadPopup();
      const createCard = document.querySelector('.create-card');
      if (createCard) {
        createCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        const titleInput = document.getElementById('title');
        if (titleInput) {
          window.setTimeout(function () {
            titleInput.focus();
          }, 350);
        }
      }
    });

    let toastTimer = null;
    function showToast(message) {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.classList.add('show');
      if (toastTimer) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(function () {
        toast.classList.remove('show');
      }, 2400);
    }

    const dpadNav = document.getElementById('dpadNav');
    const dpadPopup = document.getElementById('dpadPopup');
    const navPixelLogBtn = document.getElementById('navPixelLog');
    const panelMain = document.getElementById('panelMain');
    const panelProjects = document.getElementById('panelProjects');

    function openDpadPopup() {
      dpadPopup.classList.add('open');
      navPixelLogBtn.classList.add('active');
      navPixelLogBtn.setAttribute('aria-expanded', 'true');
    }

    function closeDpadPopup() {
      dpadPopup.classList.remove('open');
      navPixelLogBtn.classList.remove('active');
      navPixelLogBtn.setAttribute('aria-expanded', 'false');
      window.setTimeout(function () {
        panelProjects.hidden = true;
        panelMain.hidden = false;
      }, 150);
    }

    navPixelLogBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (dpadPopup.classList.contains('open')) {
        closeDpadPopup();
      } else {
        openDpadPopup();
      }
    });

    document.getElementById('projectDirBtn').addEventListener('click', function () {
      panelMain.hidden = true;
      panelProjects.hidden = false;
    });
    document.getElementById('projectsBackBtn').addEventListener('click', function () {
      panelProjects.hidden = true;
      panelMain.hidden = false;
    });

    document.addEventListener('click', function (e) {
      if (dpadPopup.classList.contains('open') && !dpadNav.contains(e.target)) {
        closeDpadPopup();
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && dpadPopup.classList.contains('open')) {
        closeDpadPopup();
      }
    });

    document.getElementById('emailCopyBtn').addEventListener('click', function () {
      const encoded = this.dataset.mailB64;
      let email = '';
      try {
        email = atob(encoded);
      } catch (err) {
        email = '';
      }
      if (!email) return;

      const fallbackCopy = function () {
        const temp = document.createElement('textarea');
        temp.value = email;
        temp.setAttribute('readonly', '');
        temp.style.position = 'absolute';
        temp.style.left = '-9999px';
        document.body.appendChild(temp);
        temp.select();
        try {
          document.execCommand('copy');
        } catch (err) {}
        document.body.removeChild(temp);
      };

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(email).then(function () {
          showToast('✔ EMAIL COPIED TO CLIPBOARD');
        }).catch(function () {
          fallbackCopy();
          showToast('✔ EMAIL COPIED TO CLIPBOARD');
        });
      } else {
        fallbackCopy();
        showToast('✔ EMAIL COPIED TO CLIPBOARD');
      }
    });

    function pixelFallback(category) {
      const wrap = document.createElement('div');
      wrap.className = 'post-card-img-fallback';
      wrap.innerHTML = '<div>▨▨▨<br/>▨▨▨</div><div>IMAGE NOT FOUND</div>';
      return wrap;
    }

    const overlay = document.getElementById('lightboxOverlay');
const lbImg = document.getElementById('lightboxImg');
const lbFallback = document.getElementById('lightboxFallback');
    const lbBadge = document.getElementById('lightboxBadge');
    const lbTitle = document.getElementById('lightboxTitle');
    const lbTimestamp = document.getElementById('lightboxTimestamp');
    const lbStory = document.getElementById('lightboxStory');
    const lbEditLink = document.getElementById('lightboxEditLink');
    const lbDeleteForm = document.getElementById('lightboxDeleteForm');
    let currentCategory = '';

    document.querySelectorAll('.post-card').forEach(function (card) {
      card.addEventListener('click', function () {
        const id = card.dataset.id;
        const title = card.dataset.title;
        const category = card.dataset.category;
        const image = card.dataset.image;
        const content = card.dataset.content;
        const created = card.dataset.created;

        currentCategory = category;
lbImg.style.display = '';
lbFallback.style.display = 'none';
lbImg.onerror = function () {
  lbImg.style.display = 'none';
  lbFallback.style.display = '';
};
lbImg.src = image || '';
if (!image) lbImg.onerror();
lbImg.alt = title;
        lbBadge.textContent = category;
        lbBadge.className = 'badge cat-' + category;
        lbTitle.textContent = title;
        lbTimestamp.textContent = new Date(created).toLocaleString();
        lbStory.textContent = content;
        lbEditLink.href = '/edit/' + id;
        lbDeleteForm.action = '/delete/' + id;

        overlay.classList.add('open');
      });
    });

    function closeLightbox() {
      overlay.classList.remove('open');
    }

    document.getElementById('lightboxClose').addEventListener('click', closeLightbox);
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closeLightbox();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>

</body>
</html>